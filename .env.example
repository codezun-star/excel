# Copia este archivo como .env.local y completa los valores.
# NUNCA subas claves reales al repositorio.

# URL pública del sitio (se usa para SEO, sitemap y redirecciones de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
# Si se dejan vacías, el sitio funciona igual (generar y descargar plantillas),
# pero se desactivan el inicio de sesión y las funciones de cuenta.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "publishable" (sb_publishable_...) o la clave "anon" heredada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Fase 2: monetización (todas opcionales en desarrollo)
# -----------------------------------------------------------------------------

# Clave SECRETA de Supabase (sb_secret_... o la "service_role" heredada).
# Solo servidor: registra descargas, procesa webhooks y aprueba pagos.
# NUNCA la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Secreto para firmar la cookie del visitante anónimo (límite de descargas sin cuenta).
# Genera uno con: openssl rand -base64 32
ANON_ID_SECRET=

# Tipo de cambio de referencia USD → HNL que se muestra en precios (no se cobra en HNL salvo transferencia)
NEXT_PUBLIC_USD_HNL_RATE=26.5
# Garantía de reembolso
NEXT_PUBLIC_REFUND_DAYS=7
NEXT_PUBLIC_REFUND_TEXT=

# Solo desarrollo: otorga un plan a todos (pro o negocio). Se ignora en producción.
DEV_GRANT_PLAN=

# --- Correo (por defecto se imprimen en la consola del servidor) ---
# EMAIL_PROVIDER=resend para enviarlos con Resend
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="Excel Codezun <no-responder@tu-dominio.com>"
# Recibe aviso de cada comprobante nuevo
ADMIN_NOTIFICATION_EMAIL=

# --- Transferencia o depósito a bancos de Honduras (proveedor "manual") ---
# Se activa con al menos un número de cuenta. Solo se muestran los bancos configurados.
PAYMENTS_MANUAL_ENABLED=true
# Titular por defecto de todas las cuentas
MANUAL_BANK_ACCOUNT_HOLDER=
# BAC Credomatic
BANK_BAC_ACCOUNT_NUMBER=
BANK_BAC_ACCOUNT_TYPE="Cuenta de ahorro"
# HNL o USD
BANK_BAC_CURRENCY=HNL
BANK_BAC_ACCOUNT_HOLDER=
# Banco Atlántida
BANK_ATLANTIDA_ACCOUNT_NUMBER=
BANK_ATLANTIDA_ACCOUNT_TYPE="Cuenta de ahorro"
BANK_ATLANTIDA_CURRENCY=HNL
BANK_ATLANTIDA_ACCOUNT_HOLDER=
# Banco Promerica
BANK_PROMERICA_ACCOUNT_NUMBER=
BANK_PROMERICA_ACCOUNT_TYPE="Cuenta de ahorro"
BANK_PROMERICA_CURRENCY=HNL
BANK_PROMERICA_ACCOUNT_HOLDER=
# Texto adicional opcional (horario de revisión, WhatsApp de soporte…)
MANUAL_PAYMENT_EXTRA=

# --- Paddle Billing (desactivado por defecto) ---
PAYMENTS_PADDLE_ENABLED=false
# sandbox o production
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_NEGOCIO_MONTHLY=
PADDLE_PRICE_NEGOCIO_YEARLY=
PADDLE_PRICE_TEMPLATE=
